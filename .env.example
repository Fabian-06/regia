# Copia este archivo como ".env" y rellena lo que necesites.
# El archivo .env no se sube al repositorio (está en .gitignore).
# Sin .env el proyecto arranca igual, con valores de desarrollo.

DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Módulo assistant (persona 4). Vacío = modo sin LLM.
LLM_API_KEY=
LLM_MODEL=
